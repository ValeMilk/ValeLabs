# MongoDB Atlas
MONGO_URI=mongodb+srv://<db_username>:<db_password>@valelabs.6noncis.mongodb.net/?appName=valelabs
MONGO_DB_NAME=valelabs_microbio

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
